# Strapi Configuration
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# MySQL Configuration (wymagane dla API lokalizacji i wycen)
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name
MYSQL_PORT=3306

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.kalkulatorynieruchomosci.pl

# Railway ML API Configuration (fallback for ML predictions)
RAILWAY_ML_API_URL=https://your-railway-ml-app.railway.app

# SECURITY: JWT Secret - GENERUJ SILNY KLUCZ!
# Użyj: openssl rand -base64 64 lub node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your-super-secure-jwt-secret-minimum-64-characters-long

# Security Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Instructions:
# 1. Copy this file to .env.local
# 2. Generate API token in Strapi admin panel (Settings -> API Tokens)
# 3. Replace 'your_strapi_api_token_here' with actual token
# 4. Configure MySQL database connection for locations and valuations
# 5. Set NEXT_PUBLIC_SITE_URL to your production domain
# 6. Set RAILWAY_ML_API_URL to your Railway ML API endpoint for hybrid ML fallback
# 7. GENERUJ SILNY JWT_SECRET - minimum 64 znaki!
# 8. W produkcji ustaw NODE_ENV=production 