generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // shadowDatabaseUrl = "mysql://hyxoyexiuq_shadow:Mi1chA2le3k!@s108.cyber-folks.pl:3306/hyxoyexiuq_shadow"
}

model email_verification_tokens {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token      String    @unique(map: "token") @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  created_at DateTime? @default(now()) @db.DateTime(0)

  @@index([user_id], map: "fk_email_token_user")
}

model geographic_features {
  id                                   Int      @id @default(autoincrement())
  city                                 String   @unique(map: "unique_city") @db.VarChar(100)
  lat                                  Decimal  @db.Decimal(10, 7)
  lon                                  Decimal  @db.Decimal(10, 7)
  population                           Int?     @default(0)
  distance_to_nearest_centrum_handlowe Int?     @default(50000)
  distance_to_nearest_szpital          Int?     @default(50000)
  distance_to_nearest_szkola           Int?     @default(50000)
  distance_to_nearest_dworzec          Int?     @default(50000)
  distance_to_nearest_park             Int?     @default(50000)
  distance_to_nearest_jezioro          Int?     @default(50000)
  distance_to_nearest_rzeka            Int?     @default(50000)
  distance_to_nearest_teatr            Int?     @default(50000)
  distance_to_nearest_muzeum           Int?     @default(50000)
  distance_to_nearest_hotel            Int?     @default(50000)
  count_centrum_handlowe_in_5km        Int?     @default(0)
  count_szpital_in_5km                 Int?     @default(0)
  count_szkola_in_5km                  Int?     @default(0)
  count_dworzec_in_5km                 Int?     @default(0)
  count_park_in_5km                    Int?     @default(0)
  count_jezioro_in_5km                 Int?     @default(0)
  count_rzeka_in_5km                   Int?     @default(0)
  count_teatr_in_5km                   Int?     @default(0)
  count_muzeum_in_5km                  Int?     @default(0)
  count_hotel_in_5km                   Int?     @default(0)
  count_centrum_handlowe_in_10km       Int?     @default(0)
  count_szpital_in_10km                Int?     @default(0)
  count_szkola_in_10km                 Int?     @default(0)
  count_dworzec_in_10km                Int?     @default(0)
  count_park_in_10km                   Int?     @default(0)
  count_jezioro_in_10km                Int?     @default(0)
  count_rzeka_in_10km                  Int?     @default(0)
  count_teatr_in_10km                  Int?     @default(0)
  count_muzeum_in_10km                 Int?     @default(0)
  count_hotel_in_10km                  Int?     @default(0)
  urbanization_score                   Int?     @default(0)
  transport_accessibility              Int?     @default(0)
  shopping_accessibility               Int?     @default(0)
  healthcare_accessibility             Int?     @default(0)
  recreation_score                     Int?     @default(0)
  created_at                           DateTime @default(now()) @db.Timestamp(0)
  updated_at                           DateTime @default(now()) @db.Timestamp(0)

  @@index([city], map: "idx_city")
  @@index([lat, lon], map: "idx_lat_lon")
}

model listings {
  id      Int       @id @default(autoincrement())
  ad_id   String?   @unique(map: "ad_id") @db.VarChar(255)
  title   String?   @db.Text
  price   String?   @db.VarChar(255)
  address String?   @db.Text
  area    String?   @db.VarChar(255)
  rooms   String?   @db.VarChar(255)
  market  String?   @db.VarChar(255)
  url     String?   @db.Text
  date    DateTime? @db.Date
}

model nieruchomosci {
  ad_id                                Int                          @id @default(autoincrement())
  listing_id                           String?                      @db.VarChar(50)
  url                                  String                       @unique(map: "url") @db.VarChar(512)
  title_raw                            String?                      @db.VarChar(500)
  address_raw                          String?                      @db.VarChar(512)
  price                                Decimal?                     @db.Decimal(12, 2)
  area                                 Decimal?                     @db.Decimal(7, 2)
  rooms                                Int?                         @db.UnsignedTinyInt
  market                               nieruchomosci_market?
  listing_date                         DateTime?                    @db.Date
  street                               String?                      @db.VarChar(200)
  district                             String?                      @db.VarChar(150)
  city                                 String?                      @db.VarChar(100)
  province                             String?                      @db.VarChar(100)
  latitude                             Decimal?                     @db.Decimal(10, 8)
  longitude                            Decimal?                     @db.Decimal(11, 8)
  has_balcony                          Boolean?                     @default(false)
  has_garage                           Boolean?                     @default(false)
  has_garden                           Boolean?                     @default(false)
  has_elevator                         Boolean?                     @default(false)
  has_basement                         Boolean?                     @default(false)
  has_separate_kitchen                 Boolean?                     @default(false)
  has_dishwasher                       Boolean?                     @default(false)
  has_fridge                           Boolean?                     @default(false)
  has_oven                             Boolean?                     @default(false)
  year_of_construction                 Int?                         @db.SmallInt
  building_type                        nieruchomosci_building_type?
  floor                                Int?                         @db.UnsignedTinyInt
  total_floors                         Int?                         @db.UnsignedTinyInt
  standard_of_finish                   Int?                         @db.UnsignedTinyInt
  heating_type                         String?                      @db.VarChar(100)
  rent_amount                          Decimal?                     @db.Decimal(8, 2)
  security_features                    String?                      @db.LongText
  media_features                       String?                      @db.LongText
  distance_to_city_center              Int?                         @db.UnsignedInt
  distance_to_nearest_school           Int?                         @db.UnsignedInt
  distance_to_nearest_kindergarten     Int?                         @db.UnsignedInt
  distance_to_nearest_public_transport Int?                         @db.UnsignedInt
  distance_to_nearest_supermarket      Int?                         @db.UnsignedInt
  distance_to_nearest_lake             Int?                         @db.UnsignedInt
  distance_to_university               Int?                         @db.UnsignedInt
  source                               String?                      @default("otodom.pl") @db.VarChar(50)
  source_page                          Int?
  source_position                      Int?
  scraped_at                           DateTime                     @default(now()) @db.Timestamp(0)
  created_at                           DateTime                     @default(now()) @db.Timestamp(0)
  updated_at                           DateTime                     @default(now()) @db.Timestamp(0)

  @@index([city], map: "idx_city")
  @@index([listing_id], map: "idx_listing_id")
  @@index([price], map: "idx_price")
  @@index([source], map: "idx_source")
  @@index([url], map: "idx_url")
}

model password_reset_tokens {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token      String    @unique(map: "token") @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  created_at DateTime? @default(now()) @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_reset_token_user")

  @@index([user_id], map: "fk_reset_token_user")
}

model property_calculations {
  id               BigInt    @id @default(autoincrement())
  user_id          BigInt
  title            String?   @db.VarChar(255)
  input_json       String?   @db.LongText
  result_json      String?   @db.LongText
  created_at       DateTime? @default(now()) @db.DateTime(0)
  updated_at       DateTime? @default(now()) @db.DateTime(0)
  calculation_type String?   @db.VarChar(255)

  @@index([user_id], map: "fk_calc_user")
}

model sessions {
  id         Int      @id @default(autoincrement())
  user_id    BigInt
  token      String   @unique(map: "token") @db.VarChar(255)
  expires_at DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "sessions_ibfk_1")

  @@index([user_id], map: "user_id")
}

model subscriptions {
  id                     BigInt                @id @default(autoincrement())
  user_id                BigInt
  stripe_subscription_id String?               @unique(map: "stripe_subscription_id") @db.VarChar(255)
  plan                   String?               @db.VarChar(100)
  status                 subscriptions_status? @default(active)
  current_period_end     DateTime?             @db.DateTime(0)
  created_at             DateTime?             @default(now()) @db.DateTime(0)
  users                  users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_sub_user")

  @@index([user_id], map: "fk_sub_user")
}

model users {
  id                    BigInt                  @id @default(autoincrement())
  email                 String                  @unique(map: "email") @db.VarChar(255)
  password_hash         String                  @db.VarChar(255)
  name                  String?                 @db.VarChar(255)
  phone                 String?                 @db.VarChar(20)
  date_of_birth        DateTime?               @db.Date
  gender                String?                 @db.VarChar(20)
  city                  String?                 @db.VarChar(100)
  postal_code           String?                 @db.VarChar(10)
  preferred_currency    String?                 @default("PLN") @db.VarChar(3)
  income_range          String?                 @db.VarChar(50)
  investment_experience String?                 @db.VarChar(50)
  preferred_property_type String?               @db.VarChar(50)
  preferred_cities      String?                 @db.LongText // JSON array
  max_budget            Decimal?                @db.Decimal(15, 2)
  min_area              Decimal?                @db.Decimal(8, 2)
  max_area              Decimal?                @db.Decimal(8, 2)
  newsletter_subscription Boolean?              @default(true)
  email_notifications   Boolean?                @default(true)
  language              String?                 @default("pl") @db.VarChar(5)
  theme                 String?                 @default("light") @db.VarChar(10)
  company_name          String?                 @db.VarChar(255)
  nip                   String?                 @db.VarChar(20)
  business_address      String?                 @db.Text
  stripe_customer_id    String?                 @db.VarChar(255)
  created_at            DateTime?               @default(now()) @db.DateTime(0)
  updated_at            DateTime?               @default(now()) @db.DateTime(0)
  password_reset_tokens password_reset_tokens[]
  sessions              sessions[]
  subscriptions         subscriptions[]
  valuation_history     ValuationHistory[]
  user_preferences      UserPreferences[]
}

model ValuationHistory {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt
  input_params String    @db.LongText // JSON z parametrami wejściowymi wyceny
  result       String    @db.LongText // JSON z wynikami wyceny
  created_at   DateTime  @default(now()) @db.DateTime(0)
  updated_at   DateTime  @default(now()) @db.DateTime(0)
  user         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_valuation_user")

  @@index([user_id], map: "fk_valuation_user")
  @@index([created_at], map: "idx_valuation_created")
}

enum subscriptions_status {
  trialing
  active
  past_due
  canceled
  unpaid
}

enum nieruchomosci_market {
  pierwotny
  wt_rny    @map("wtórny")
}

enum nieruchomosci_building_type {
  blok
  kamienica
  apartamentowiec
  dom_wielorodzinny @map("dom wielorodzinny")
  wielka_p_yta      @map("wielka płyta")
  dom
  inny
}

model UserPreferences {
  id                    BigInt    @id @default(autoincrement())
  user_id               BigInt
  notification_settings String?   @db.LongText // JSON z ustawieniami powiadomień
  saved_searches        String?   @db.LongText // JSON z zapisanymi wyszukiwaniami
  favorite_properties   String?   @db.LongText // JSON z ulubionymi nieruchomościami
  calculator_history    String?   @db.LongText // JSON z historią kalkulatorów
  created_at            DateTime  @default(now()) @db.DateTime(0)
  updated_at            DateTime  @default(now()) @db.DateTime(0)
  user                  users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_preferences_user")

  @@index([user_id], map: "idx_user_preferences_user")
}
